{
	"name": "lime",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	"triggers": {
		"crons": ["0 1 * * 1-5"], // 08:00 giờ VN, thứ 2 đến thứ 6 (cron tính theo UTC)
	},
	"kv_namespaces": [{ "binding": "STATE", "id": "3c05237c9185476da7b32c4ebdb3f185" }],
	"vars": {
		"GEMINI_MODEL": "gemini-3.5-flash-lite",
		"GEMINI_FALLBACK_MODEL": "gemini-3.7-flash",
	},
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true,
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true,
		},
		"issue_detection": {
			"enabled": false,
		},
	},
}
